{
  "name": "electron-template",
  "productName": "Electron Template",
  "version": "0.1.0",
  "description": "Electron + Vite 8 + React 19 + electron-forge starter",
  "license": "MIT",
  "private": true,
  "main": ".vite/build/main.js",
  "engines": {
    "node": "^22.0.0"
  },
  "scripts": {
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "rebuild": "electron-rebuild -f",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "build": "node scripts/build.mjs",
    "make": "electron-forge make",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@trpc/client": "^10.45.4",
    "@trpc/server": "^10.45.4",
    "better-sqlite3": "^13.0.1",
    "drizzle-orm": "^0.45.2",
    "electron-about-window": "^1.15.2",
    "electron-context-menu": "^4.1.2",
    "electron-log": "^5.4.4",
    "electron-store": "^11.0.2",
    "electron-trpc": "^0.7.1",
    "menubar": "^9.5.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^3.23.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron-forge/shared-types": "^7.11.2",
    "@electron/fuses": "^2.1.3",
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "drizzle-kit": "^0.31.10",
    "electron": "^43.2.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.5"
  }
}
